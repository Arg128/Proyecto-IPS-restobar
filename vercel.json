{
  "buildCommand": "npx turbo run build && node scripts/assemble-builds.js",
  "installCommand": "pnpm install",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/admin/index.html" },
    { "source": "/cocina/(.*)", "destination": "/cocina/index.html" },
    { "source": "/caja/(.*)", "destination": "/caja/index.html" },
    { "source": "/delivery/(.*)", "destination": "/delivery/index.html" },
    { "source": "/", "destination": "/admin/index.html" }
  ]
}
