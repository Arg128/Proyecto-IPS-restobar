# ============================================
# Vars de entorno para Vercel (REACT_APP_*)
# Configurar en: Vercel Dashboard → Project → Settings → Environment Variables
# ============================================

# Admin frontend → se conecta a admin-backend
REACT_APP_API_URL=https://admin-backend.vercel.app

# Cocina frontend → se conecta a cocina-backend
# REACT_APP_API_URL=https://cocina-backend.vercel.app

# Caja frontend → se conecta a caja-backend
# REACT_APP_API_URL=https://caja-backend.vercel.app

# Delivery frontend → se conecta a delivery-backend
# REACT_APP_API_URL=https://delivery-backend.vercel.app

# ============================================
# IMPORTANTE:
# Cada frontend debe tener su propia variable REACT_APP_API_URL
# apuntando a su backend correspondiente.
# Configurar una variable DISTINTA por proyecto Vercel.
# ============================================
