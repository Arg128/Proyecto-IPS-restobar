# ============================================
# Vars de entorno para Vercel
# Configurar en: Vercel Dashboard → Project → Settings → Environment Variables
# ============================================

# --- Backend (resto-backend) ---
# Lista de orígenes permitidos por CORS (separados por coma)
# Ej: https://admin-frontend.vercel.app,https://caja-frontend.vercel.app,https://cocina-frontend.vercel.app
CORS_ORIGINS=https://proyecto-ips-restobar-admin-backend.vercel.app,https://proyecto-ips-restobar-caja-frontend.vercel.app,https://proyecto-ips-restobar-cocina-fronte.vercel.app,https://proyecto-ips-restobar-delivery-fron.vercel.app

# --- Frontends (REACT_APP_*) ---
# Todos los frontends apuntan al backend unificado resto-backend
REACT_APP_API_URL=https://proyecto-ips-resto-backend.vercel.app

# ============================================
# IMPORTANTE:
# - Configurar CORS_ORIGINS en el proyecto Vercel de resto-backend con las URLs
#   de todos los frontends desplegados.
# - Configurar REACT_APP_API_URL en cada frontend apuntando a la URL del backend.
# ============================================
