{
  "globalEnv": [
    "NODE_ENV",
    "PORT",
    "HOST",
    "ADMIN_FRONTEND_PORT",
    "COCINA_BACKEND_PORT",
    "COCINA_FRONTEND_PORT",
    "CAJA_BACKEND_PORT",
    "CAJA_FRONTEND_PORT",
    "DELIVERY_BACKEND_PORT",
    "DELIVERY_FRONTEND_PORT",
    "MESAS_BACKEND_PORT",
    "MESAS_FRONTEND_PORT",
    "DB_USER",
    "DB_PASSWORD",
    "DB_NAME",
    "DB_HOST",
    "DB_PORT",
    "DB_DIALECT",
    "JWT_SECRET",
    "VERCEL",
    "VERCEL_ENV",
    "VERCEL_URL"
],
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:seed": {
      "dependsOn": ["db:migrate"],
      "cache": false
    },
    "db:generate": {
      "dependsOn": ["db:generate"],
      "cache": false
    },
    "start": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
